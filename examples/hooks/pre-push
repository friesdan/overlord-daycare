#!/usr/bin/env bash
# pre-push hook template — the fast checks that run before EVERY push.
# docs/ci-and-gates.md, layer 0: lint, typecheck, unit tests; seconds, not
# minutes. Anything slower belongs in CI, not here.
#
# Install by copying it into your hooks directory:
#   cp examples/hooks/pre-push .git/hooks/pre-push
#   chmod +x .git/hooks/pre-push
#
# The rule: NEVER skip this hook. `git push --no-verify` exists, and using it
# "just this once" under pressure is exactly how the mistake ships. If a check
# is too slow to wait for, move it into CI — do not remove the gate.
set -euo pipefail

cat >/dev/null # git sends the refs being pushed on stdin; consume them

cd "$(git rev-parse --show-toplevel)"

say() { printf 'pre-push: %s\n' "$1" >&2; }

run_check() { # run_check <label> <command...>
    local label="$1"; shift
    say "running $label"
    "$@"
}

# --- replace these with YOUR project's fast checks ---------------------------
run_check 'lint' npm run lint
run_check 'typecheck' npm run typecheck
run_check 'unit tests' npm run test:unit
# ------------------------------------------------------------------------------

say 'all fast checks passed'
