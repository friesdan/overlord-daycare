#!/usr/bin/env bash
# bin/worker <task-name> <task-file>
#
# Create an isolated git worktree + branch for the task, run the configured
# worker command there with the task text plus a standard instruction block
# (edit, run tests, commit, push the branch, stop — never merge), and log
# everything to .overlord/runs/<task>/worker.log. Updates STATE.md. Merging
# is the hosting platform's job (see bin/merge-when-green), never the worker's.
set -u -o pipefail
# shellcheck disable=SC1091  # path is relative to this script

. "$(dirname "$0")/../lib/common.sh"

usage() {
    cat <<'EOF'
usage: bin/worker <task-name> <task-file>

Create a worktree + branch mt/<task-name> off the configured base branch,
run the worker AI command inside it with the task file as the brief, and
record the run under .overlord/runs/<task-name>/.

  task-name   short slug (letters, digits, . _ -); becomes branch mt/<task-name>
  task-file   markdown file describing the task (the worker's brief)

Environment overrides (see ./init): OVERLORD_WORKER_CMD, OVERLORD_WORKER_TIMEOUT, ...
The worker command may reference "$PROMPT", "$PROMPT_FILE", "$OVERLORD_WORKTREE".
The worker starts from an empty env (env -i) plus a per-task allowlist: the
base allowlist (PATH, HOME, LANG, LC_*, TERM, TMPDIR, OVERLORD_PASS_ENV) plus
an optional per-task profile at .overlord/profiles/<task>.env holding only
the credentials this task needs. Production credentials never belong there.
Env filtering is not a sandbox: HOME is passed through, so credential files
under it (~/.config/gh, ~/.ssh, ~/.aws, ...) remain readable — see HOW-WE-WORK.md.
After the worker commits, this script pushes the branch if a remote exists
(and prints how to open the PR). Workers never merge.
Exits non-zero if the worker command fails or commits nothing.
EOF
}

[ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ] && { usage; exit 0; }
[ $# -eq 2 ] || { usage >&2; exit 1; }

task="$1"
task_file="$2"
valid_task_name "$task" || die "invalid task name '$task' (use letters, digits, . _ -)"

[ -f "$task_file" ] || die "task file not found: $task_file
Pass it relative to the current directory or as an absolute path."
task_file="$(cd "$(dirname "$task_file")" && pwd)/$(basename "$task_file")"

load_config

branch="$(task_branch "$task")"
worktree="$(task_worktree "$task")"
run_dir="$(task_run_dir "$task")"

[ -e "$worktree" ] && die "worktree already exists: $worktree
If the task is finished, push it and open its PR (or merge via bin/merge-when-green), or clean up:
  git -C \"$OVERLORD_PROJECT_DIR\" worktree remove --force \"$worktree\"
  git -C \"$OVERLORD_PROJECT_DIR\" branch -D \"$branch\"
If the project was recreated since (e.g. re-running ./init --demo), git no
longer knows this worktree and the commands above fail — delete the leftover
directory instead: rm -rf \"$worktree\""

if git -C "$OVERLORD_PROJECT_DIR" show-ref --verify --quiet "refs/heads/$branch"; then
    die "branch already exists: $branch
Pick a new task name, or delete the branch: git -C \"$OVERLORD_PROJECT_DIR\" branch -D \"$branch\""
fi

git -C "$OVERLORD_PROJECT_DIR" show-ref --verify --quiet "refs/heads/$OVERLORD_BASE_BRANCH" || \
    die "base branch '$OVERLORD_BASE_BRANCH' not found in $OVERLORD_PROJECT_DIR (check OVERLORD_BASE_BRANCH in $OVERLORD_CONFIG)"

mkdir -p "$run_dir" "$OVERLORD_WORKTREE_ROOT"

info "==> creating worktree $worktree (branch $branch from $OVERLORD_BASE_BRANCH)"
if ! git -C "$OVERLORD_PROJECT_DIR" worktree add -b "$branch" "$worktree" "$OVERLORD_BASE_BRANCH" \
        > "$run_dir/worktree.log" 2>&1; then
    cat "$run_dir/worktree.log" >&2
    die "git worktree add failed (see $run_dir/worktree.log)"
fi

# ---- Build the worker prompt: task text + standard instruction block -------
{
    cat <<EOF
# Task: $task

Your job is a single bounded change in an isolated git worktree. Push your
branch and stop; a different model reviews it and the hosting platform merges
it. You never merge.

## The task (from $(basename "$task_file"))

EOF
    cat "$task_file"
    cat <<EOF

## Rules

- You are in $worktree — a git worktree of $(basename "$OVERLORD_PROJECT_DIR") on branch $branch.
- Make the smallest change that completes the task. Nothing else.
- Run the tests with: $OVERLORD_TEST_CMD
- Fix the code until the tests pass, then stage and commit everything
  (git add -A && git commit) on the current branch.
- Push your branch (git push -u origin $branch) so a pull request can be
  opened from it. Never merge. Never touch other branches or checkouts.
- Your environment holds only the credentials this task needs (a per-task
  profile). Do not go looking for more — in particular, do not read
  credential files under the home directory.
- When done (or blocked), print a short summary of what you changed and stop.
EOF
} > "$run_dir/prompt.md"

PROMPT="$(cat "$run_dir/prompt.md")"
export PROMPT
export PROMPT_FILE="$run_dir/prompt.md"
export OVERLORD_WORKTREE="$worktree"
export OVERLORD_TASK="$task"

# Per-task profile: only the credentials this task needs. The profile lives
# under .overlord/profiles/ — outside the worker-writable worktree — and any
# control character in it refuses the launch (lib/common.sh).
load_task_profile "$task" "$worktree"

info "==> running worker (in $worktree): $OVERLORD_WORKER_CMD"
info "    (log: $run_dir/worker.log; timeout: ${OVERLORD_WORKER_TIMEOUT}s)"
info "    env: empty env (env -i) + per-task allowlist (${OVERLORD_ALLOW_ENV:-PATH HOME ...}${OVERLORD_PASS_ENV:+; pass: $OVERLORD_PASS_ENV}; profile: $(task_env_profile "$task"))"
rc=0
( cd "$worktree" && run_bounded "$OVERLORD_WORKER_TIMEOUT" "$OVERLORD_WORKER_CMD" ) \
    2>&1 | tee "$run_dir/worker.log" || rc=$?

state_set "$task" status "open"
state_set "$task" branch "$branch"
state_set "$task" worktree "$worktree"
state_set "$task" last_step "worker"

commits="$(git -C "$worktree" rev-list --count "$OVERLORD_BASE_BRANCH..$branch" 2>/dev/null || echo 0)"

if [ "$rc" -ne 0 ]; then
    state_set "$task" next_step "rework: worker exited $rc — read $run_dir/worker.log, fix, rerun bin/worker with a fresh task name or finish by hand"
    die "worker command exited $rc — full log: $run_dir/worker.log"
fi

if [ "$commits" -eq 0 ]; then
    state_set "$task" next_step "rework: worker committed nothing — read $run_dir/worker.log"
    die "worker exited 0 but made no commits on $branch
Nothing to review. Check the log: $run_dir/worker.log"
fi

state_set "$task" next_step "review"

# Push the branch so a pull request can be opened. With no remote (the demo,
# a purely local project) this is skipped — the branch and worktree stay put.
if git -C "$worktree" remote | grep -q .; then
    if git -C "$worktree" push -u origin "$branch" >> "$run_dir/worker.log" 2>&1; then
        info "==> pushed $branch — open its pull request, then: bin/review $task"
    else
        warn "git push of $branch failed (see $run_dir/worker.log) — push it by hand, then open the PR"
    fi
else
    info "==> no git remote — branch stays local; add a remote, push $branch, and open its PR when ready"
fi

info "==> worker done: $commits commit(s) on $branch"
info "    next: bin/review $task"
exit 0
