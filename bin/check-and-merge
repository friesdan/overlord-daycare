#!/usr/bin/env bash
# bin/check-and-merge [--yes] <task-name>
#
# The merge gate. The human sets the rules and the gates; the coordinator may
# merge on its own once you trust those gates — that trust is the approval
# rule: 'human' (default) asks "Merge into <base>? [y/N]", 'auto' merges with
# no prompt only when tests pass AND the review verdict is CLEAN. Runs the
# configured test command inside the task's worktree, shows a summary (tests,
# review verdict, diffstat), then applies the rule (--yes counts as a human
# yes). On approval: merge the task branch into the base branch (a real merge
# — fast-forward only when possible; aborts on conflict), remove the worktree,
# keep the branch. NEVER pushes. Updates STATE.md.
#
# Approvals bind to the exact commit: bin/review records the commit SHA it
# reviewed, and this gate refuses to merge unless that SHA is the exact head
# of the branch being merged. A later commit never inherits an old CLEAN
# verdict — a stale or missing review refuses with exit 2, and the merge
# itself merges that exact SHA.
set -u -o pipefail
# shellcheck disable=SC1091  # path is relative to this script

. "$(dirname "$0")/../lib/common.sh"

refuse() { # refuse <reason> — a gate refusal, distinct from an error (exit 2)
    printf 'refused: %s\n' "$*" >&2
    exit 2
}

usage() {
    cat <<'EOF'
usage: bin/check-and-merge [--yes] <task-name>

The merge gate. Runs the tests in the task's worktree, prints a summary of
tests / review verdict / diffstat, then decides:

  --yes                 treat the human approval as given (CI, demos)
  approval rule 'auto'  merge with no prompt, but ONLY if tests pass AND
                        the review verdict is CLEAN
  otherwise             ask "Merge into <base>? [y/N]"

The review must be bound to the exact commit being merged: bin/review records
the commit SHA it reviewed, and a stale review (branch has moved on) or a
missing one refuses with exit 2 — re-run bin/review on the new head. The
merge itself merges that exact SHA, re-verified just before it happens.

Merging never pushes. The worktree is removed after a successful merge; the
mt/<task> branch is kept as a record (delete it yourself when done).
Exit codes: 0 = merged (or user answered no), 1 = error, 2 = gate refused.
EOF
}

yes_flag=0; task=""
while [ $# -gt 0 ]; do
    case "$1" in
        --yes|-y) yes_flag=1 ;;
        --help|-h) usage; exit 0 ;;
        -*) die "unknown option: $1 (try --help)" ;;
        *)  if [ -n "$task" ]; then die "too many arguments: $1 (try --help)"; fi
            task="$1" ;;
    esac
    shift
done
[ -n "$task" ] || { usage >&2; exit 1; }
valid_task_name "$task" || die "invalid task name '$task'"

load_config

branch="$(task_branch "$task")"
run_dir="$(task_run_dir "$task")"
git -C "$OVERLORD_PROJECT_DIR" show-ref --verify --quiet "refs/heads/$branch" || \
    die "branch $branch not found in $OVERLORD_PROJECT_DIR — run bin/worker $task first"

worktree="$(state_get "$task" worktree)"
[ -n "$worktree" ] && [ -d "$worktree" ] || \
    die "no worktree found for task '$task' (expected it at ${worktree:-<unset>}).
If it was merged or cleaned up already, nothing to do. Otherwise run bin/worker $task."

mkdir -p "$run_dir"

# ---- 1. Tests, inside the worktree ----------------------------------------
info "==> running tests in $worktree"
info "    test command: $OVERLORD_TEST_CMD"
tests_rc=0
( cd "$worktree" && run_bounded "$OVERLORD_TEST_TIMEOUT" "$OVERLORD_TEST_CMD" ) \
    2>&1 | tee "$run_dir/tests.log" || tests_rc=$?
if [ "$tests_rc" -eq 0 ]; then tests="pass"; else tests="FAIL (exit $tests_rc)"; fi

# ---- 2. Review verdict + diffstat ------------------------------------------
head_sha="$(git -C "$OVERLORD_PROJECT_DIR" rev-parse "$branch")"
review_sha="$(state_get "$task" review_commit)"
review_branch="$(state_get "$task" review_branch)"
verdict="$(state_get "$task" review_verdict)"
[ -n "$verdict" ] || verdict="(none — run bin/review $task)"
review_short="(none yet)"
[ -n "$review_sha" ] && review_short="${review_sha:0:12}"
diffstat="$(git -C "$OVERLORD_PROJECT_DIR" diff --stat "$OVERLORD_BASE_BRANCH...$branch" | tail -1)"

echo
info "================= merge gate: $task ================="
printf '  tests   : %s\n' "$tests"
printf '  review  : %s\n' "$verdict"
printf '  commit  : %s (reviewed: %s)\n' "${head_sha:0:12}" "$review_short"
printf '  diff    : %s\n' "${diffstat:-<empty>}"
printf '  branch  : %s -> merge into %s\n' "$branch" "$OVERLORD_BASE_BRANCH"
info "====================================================="

if [ "$tests" != "pass" ]; then
    state_set "$task" tests "fail"
    state_set "$task" next_step "fix tests in $worktree, commit, rerun bin/check-and-merge $task"
    die "tests fail — not merging. Log: $run_dir/tests.log
The worktree is untouched at $worktree"
fi
state_set "$task" tests "pass"

# ---- 2b. The review must be bound to the exact commit being merged ----------
# bin/review records the SHA (and branch) it reviewed. An approval never
# carries across a new commit: stale or missing review -> refuse, whatever
# the approval rule (re-run bin/review; it is cheap next to a bad merge).
if [ -z "$review_sha" ]; then
    state_set "$task" next_step "merge gate refused: no review recorded for ${branch} at ${head_sha:0:12} — run bin/review $task"
    refuse "no review recorded for $task.
bin/review $task must run on the exact commit before it can merge —
approvals bind to a commit, not to a branch."
fi
if [ "$review_sha" != "$head_sha" ]; then
    state_set "$task" next_step "merge gate refused: review is for ${review_sha:0:12} but $branch is at ${head_sha:0:12} — re-run bin/review $task"
    refuse "stale review for $task.
The recorded verdict (branch ${review_branch:-?}, commit ${review_sha:0:12}) does not
apply to the current head of $branch (${head_sha:0:12}): commits were added after the
review. A new commit cannot inherit an old approval — re-run: bin/review $task"
fi

# ---- 3. The approval decision ----------------------------------------------
if [ "$OVERLORD_APPROVAL_RULE" != "auto" ] && [ "$yes_flag" -ne 1 ]; then
    if [ "$verdict" = "FINDINGS" ]; then
        info "NOTE: review verdict is FINDINGS — read $run_dir/review.md before answering."
    fi
    answer=""
    if [ -t 0 ]; then
        printf 'Merge into %s? [y/N] ' "$OVERLORD_BASE_BRANCH"
        read -r answer || answer=""
    elif ( exec 3</dev/tty ) 2>/dev/null; then
        printf 'Merge into %s? [y/N] ' "$OVERLORD_BASE_BRANCH"
        read -r answer < /dev/tty || answer=""
    else
        info "no terminal for the approval question — treating it as 'no'."
        info "approve non-interactively with: bin/check-and-merge --yes $task"
    fi
    case "$answer" in
        y|Y|yes|YES) ;;
        *) info "left unmerged — worktree kept at $worktree
  resume with: bin/check-and-merge $task"
           state_set "$task" next_step "merge gate: awaiting approval (bin/check-and-merge $task)"
           exit 0 ;;
    esac
elif [ "$OVERLORD_APPROVAL_RULE" = "auto" ] && [ "$yes_flag" -ne 1 ]; then
    if [ "$verdict" != "CLEAN" ]; then
        state_set "$task" next_step "auto-merge refused: review verdict is '$verdict' — fix findings or approve manually"
        info "approval rule is 'auto' but the review verdict is '$verdict' — NOT merging.
Read $run_dir/review.md; fix the findings, or re-run with --yes to approve as human."
        exit 2
    fi
    info "approval rule is 'auto', tests pass, review is CLEAN — merging."
else
    # --yes given: human approved out-of-band. Tests passed above; warn on findings.
    if [ "$verdict" = "FINDINGS" ]; then
        warn "--yes given while review verdict is FINDINGS — merging on explicit human approval."
    fi
fi

# ---- 4. Merge into the base branch ----------------------------------------
current="$(git -C "$OVERLORD_PROJECT_DIR" rev-parse --abbrev-ref HEAD)"
if [ "$current" != "$OVERLORD_BASE_BRANCH" ]; then
    if [ -n "$(git -C "$OVERLORD_PROJECT_DIR" status --porcelain)" ]; then
        state_set "$task" next_step "merge gate: approved, but $OVERLORD_PROJECT_DIR is on '$current' with uncommitted changes — commit or stash, checkout $OVERLORD_BASE_BRANCH, rerun"
        die "$OVERLORD_PROJECT_DIR is on branch '$current' with uncommitted changes.
Commit or stash there, 'git checkout $OVERLORD_BASE_BRANCH', then re-run: bin/check-and-merge $task"
    fi
    info "==> switching $OVERLORD_PROJECT_DIR from '$current' to '$OVERLORD_BASE_BRANCH' for the merge"
    git -C "$OVERLORD_PROJECT_DIR" checkout "$OVERLORD_BASE_BRANCH" > "$run_dir/merge.log" 2>&1 \
        || die "git checkout $OVERLORD_BASE_BRANCH failed (see $run_dir/merge.log)"
fi

info "==> merging $head_sha ($branch) into $OVERLORD_BASE_BRANCH (never pushes)"
# Merge the exact reviewed commit, and only if the branch still points at it —
# a commit landing between the gate summary and the merge changes what the
# approval covered, so it is the same stale-review refusal as above.
if [ "$(git -C "$OVERLORD_PROJECT_DIR" rev-parse "$branch")" != "$head_sha" ]; then
    state_set "$task" next_step "merge gate refused: $branch moved during the gate — re-run bin/review $task on the new head"
    refuse "branch $branch moved while the gate was running (expected $head_sha, now $(git -C "$OVERLORD_PROJECT_DIR" rev-parse "$branch")).
Re-run bin/review $task on the new head, then bin/check-and-merge $task again."
fi
if ! git -C "$OVERLORD_PROJECT_DIR" merge --no-edit "$head_sha" >> "$run_dir/merge.log" 2>&1; then
    git -C "$OVERLORD_PROJECT_DIR" merge --abort >> "$run_dir/merge.log" 2>&1
    state_set "$task" next_step "merge conflict: resolve by hand in $OVERLORD_PROJECT_DIR (merge mt branch manually), or rebase $branch onto $OVERLORD_BASE_BRANCH"
    die "merge conflict — merge aborted cleanly, nothing changed on $OVERLORD_BASE_BRANCH.
The branch $branch and worktree $worktree are untouched.
Resolve by hand: cd $OVERLORD_PROJECT_DIR && git merge $branch"
fi
tail -3 "$run_dir/merge.log" 2>/dev/null || true

# ---- 5. Clean up the worktree (branch is kept as the record) ---------------
if git -C "$OVERLORD_PROJECT_DIR" worktree remove "$worktree" >> "$run_dir/merge.log" 2>&1; then
    info "==> worktree removed: $worktree"
else
    warn "could not remove worktree $worktree (uncommitted files?) — remove it with:
  git -C \"$OVERLORD_PROJECT_DIR\" worktree remove --force \"$worktree\""
fi

state_set "$task" status "merged"
state_set "$task" last_step "merge"
state_set "$task" next_step "none (merged; branch $branch kept — delete with: git -C \"$OVERLORD_PROJECT_DIR\" branch -d $branch)"
state_set "$task" worktree "(removed: $worktree)"

echo
info "merged $branch into $OVERLORD_BASE_BRANCH. NOT pushed — push yourself when ready:"
info "  git -C \"$OVERLORD_PROJECT_DIR\" push"
exit 0
