#!/usr/bin/env bash
# bin/check-and-merge [--yes] <task-name>
#
# Run the configured test command inside the task's worktree, show a summary
# (tests, review verdict, diffstat), then ask "Merge into <base>? [y/N]"
# unless the approval rule is 'auto' or --yes was given. On approval: merge
# the task branch into the base branch (a real merge — fast-forward only when
# possible; aborts on conflict), remove the worktree, keep the branch.
# NEVER pushes. Updates STATE.md.
set -u -o pipefail
# shellcheck disable=SC1091  # path is relative to this script

. "$(dirname "$0")/../lib/common.sh"

usage() {
    cat <<'EOF'
usage: bin/check-and-merge [--yes] <task-name>

The merge gate. Runs the tests in the task's worktree, prints a summary of
tests / review verdict / diffstat, then decides:

  --yes                 treat the human approval as given (CI, demos)
  approval rule 'auto'  merge with no prompt, but ONLY if tests pass AND
                        the review verdict is CLEAN
  otherwise             ask "Merge into <base>? [y/N]"

Merging never pushes. The worktree is removed after a successful merge; the
mt/<task> branch is kept as a record (delete it yourself when done).
Exit codes: 0 = merged (or user answered no), 1 = error, 2 = gate refused.
EOF
}

yes_flag=0; task=""
while [ $# -gt 0 ]; do
    case "$1" in
        --yes|-y) yes_flag=1 ;;
        --help|-h) usage; exit 0 ;;
        -*) die "unknown option: $1 (try --help)" ;;
        *)  if [ -n "$task" ]; then die "too many arguments: $1 (try --help)"; fi
            task="$1" ;;
    esac
    shift
done
[ -n "$task" ] || { usage >&2; exit 1; }
valid_task_name "$task" || die "invalid task name '$task'"

load_config

branch="$(task_branch "$task")"
run_dir="$(task_run_dir "$task")"
git -C "$MTC_PROJECT_DIR" show-ref --verify --quiet "refs/heads/$branch" || \
    die "branch $branch not found in $MTC_PROJECT_DIR — run bin/worker $task first"

worktree="$(state_get "$task" worktree)"
[ -n "$worktree" ] && [ -d "$worktree" ] || \
    die "no worktree found for task '$task' (expected it at ${worktree:-<unset>}).
If it was merged or cleaned up already, nothing to do. Otherwise run bin/worker $task."

mkdir -p "$run_dir"

# ---- 1. Tests, inside the worktree ----------------------------------------
info "==> running tests in $worktree"
info "    test command: $MTC_TEST_CMD"
tests_rc=0
( cd "$worktree" && run_bounded "$MTC_TEST_TIMEOUT" "$MTC_TEST_CMD" ) \
    2>&1 | tee "$run_dir/tests.log" || tests_rc=$?
if [ "$tests_rc" -eq 0 ]; then tests="pass"; else tests="FAIL (exit $tests_rc)"; fi

# ---- 2. Review verdict + diffstat ------------------------------------------
verdict="$(state_get "$task" review_verdict)"
[ -n "$verdict" ] || verdict="(none — run bin/review $task)"
diffstat="$(git -C "$MTC_PROJECT_DIR" diff --stat "$MTC_BASE_BRANCH...$branch" | tail -1)"

echo
info "================= merge gate: $task ================="
printf '  tests   : %s\n' "$tests"
printf '  review  : %s\n' "$verdict"
printf '  diff    : %s\n' "${diffstat:-<empty>}"
printf '  branch  : %s -> merge into %s\n' "$branch" "$MTC_BASE_BRANCH"
info "====================================================="

if [ "$tests" != "pass" ]; then
    state_set "$task" tests "fail"
    state_set "$task" next_step "fix tests in $worktree, commit, rerun bin/check-and-merge $task"
    die "tests fail — not merging. Log: $run_dir/tests.log
The worktree is untouched at $worktree"
fi
state_set "$task" tests "pass"

# ---- 3. The approval decision ----------------------------------------------
if [ "$MTC_APPROVAL_RULE" != "auto" ] && [ "$yes_flag" -ne 1 ]; then
    if [ "$verdict" = "FINDINGS" ]; then
        info "NOTE: review verdict is FINDINGS — read $run_dir/review.md before answering."
    fi
    answer=""
    if [ -t 0 ] || [ -r /dev/tty ]; then
        printf 'Merge into %s? [y/N] ' "$MTC_BASE_BRANCH"
        if [ -t 0 ]; then read -r answer || answer=""; else read -r answer < /dev/tty || answer=""; fi
    else
        info "no terminal for the approval question — treating it as 'no'."
        info "approve non-interactively with: bin/check-and-merge --yes $task"
    fi
    case "$answer" in
        y|Y|yes|YES) ;;
        *) info "left unmerged — worktree kept at $worktree
  resume with: bin/check-and-merge $task"
           state_set "$task" next_step "merge gate: awaiting approval (bin/check-and-merge $task)"
           exit 0 ;;
    esac
elif [ "$MTC_APPROVAL_RULE" = "auto" ] && [ "$yes_flag" -ne 1 ]; then
    if [ "$verdict" != "CLEAN" ]; then
        state_set "$task" next_step "auto-merge refused: review verdict is '$verdict' — fix findings or approve manually"
        info "approval rule is 'auto' but the review verdict is '$verdict' — NOT merging.
Read $run_dir/review.md; fix the findings, or re-run with --yes to approve as human."
        exit 2
    fi
    info "approval rule is 'auto', tests pass, review is CLEAN — merging."
else
    # --yes given: human approved out-of-band. Tests passed above; warn on findings.
    if [ "$verdict" = "FINDINGS" ]; then
        warn "--yes given while review verdict is FINDINGS — merging on explicit human approval."
    fi
fi

# ---- 4. Merge into the base branch ----------------------------------------
current="$(git -C "$MTC_PROJECT_DIR" rev-parse --abbrev-ref HEAD)"
if [ "$current" != "$MTC_BASE_BRANCH" ]; then
    if [ -n "$(git -C "$MTC_PROJECT_DIR" status --porcelain)" ]; then
        state_set "$task" next_step "merge gate: approved, but $MTC_PROJECT_DIR is on '$current' with uncommitted changes — commit or stash, checkout $MTC_BASE_BRANCH, rerun"
        die "$MTC_PROJECT_DIR is on branch '$current' with uncommitted changes.
Commit or stash there, 'git checkout $MTC_BASE_BRANCH', then re-run: bin/check-and-merge $task"
    fi
    info "==> switching $MTC_PROJECT_DIR from '$current' to '$MTC_BASE_BRANCH' for the merge"
    git -C "$MTC_PROJECT_DIR" checkout "$MTC_BASE_BRANCH" > "$run_dir/merge.log" 2>&1 \
        || die "git checkout $MTC_BASE_BRANCH failed (see $run_dir/merge.log)"
fi

info "==> merging $branch into $MTC_BASE_BRANCH (never pushes)"
if ! git -C "$MTC_PROJECT_DIR" merge --no-edit "$branch" >> "$run_dir/merge.log" 2>&1; then
    git -C "$MTC_PROJECT_DIR" merge --abort >> "$run_dir/merge.log" 2>&1
    state_set "$task" next_step "merge conflict: resolve by hand in $MTC_PROJECT_DIR (merge mt branch manually), or rebase $branch onto $MTC_BASE_BRANCH"
    die "merge conflict — merge aborted cleanly, nothing changed on $MTC_BASE_BRANCH.
The branch $branch and worktree $worktree are untouched.
Resolve by hand: cd $MTC_PROJECT_DIR && git merge $branch"
fi
tail -3 "$run_dir/merge.log" 2>/dev/null || true

# ---- 5. Clean up the worktree (branch is kept as the record) ---------------
if git -C "$MTC_PROJECT_DIR" worktree remove "$worktree" >> "$run_dir/merge.log" 2>&1; then
    info "==> worktree removed: $worktree"
else
    warn "could not remove worktree $worktree (uncommitted files?) — remove it with:
  git -C \"$MTC_PROJECT_DIR\" worktree remove --force \"$worktree\""
fi

state_set "$task" status "merged"
state_set "$task" last_step "merge"
state_set "$task" next_step "none (merged; branch $branch kept — delete with: git -C \"$MTC_PROJECT_DIR\" branch -d $branch)"
state_set "$task" worktree "(removed: $worktree)"

echo
info "merged $branch into $MTC_BASE_BRANCH. NOT pushed — push yourself when ready:"
info "  git -C \"$MTC_PROJECT_DIR\" push"
exit 0
